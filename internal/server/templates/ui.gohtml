{{define "dashboard"}}
<section id="dashboard" class="dashboard app-shell" hx-ext="sse" sse-connect="{{.StreamURL}}">
  {{template "view-state" .}}

  <header class="topbar">
    <div class="brand-wrap">
      <div id="connection-dot" class="brand-dot offline"></div>
      <div>
        <h1>gTorrent</h1>
        <p>rTorrent Remote Client</p>
      </div>
    </div>
    <div class="topbar-right">
      {{template "stats" .}}
    </div>
  </header>

  {{template "controls" .}}
  {{template "add-dialog" .}}
  <div id="status-preserve" hx-preserve class="status-preserve">
    {{template "status" .}}
  </div>
  {{template "file-list" .}}
</section>
{{end}}

{{define "fragments"}}
{{template "view-state" .}}
{{template "stats" .}}
{{template "controls" .}}
{{template "add-dialog" .}}
{{template "status" .}}
{{template "file-list" .}}
{{end}}

{{define "view-state"}}
<form id="view-state" hidden{{if .SwapOOB}} hx-swap-oob="outerHTML"{{end}}>
  <input type="hidden" name="q" value="{{.Params.Query}}">
  <input type="hidden" name="filter" id="filter-input" value="{{.Params.Filter}}">
  <input type="hidden" name="sort" id="sort-input" value="{{.Params.Sort}}">
  <input type="hidden" name="dir" id="dir-input" value="{{.Params.Dir}}">
  <input type="hidden" name="selected" id="selected-input" value="{{.Params.Selected}}">
  <input type="hidden" name="cols" id="cols-input" value="{{.Params.Cols}}">
</form>
{{end}}

{{define "controls"}}
<section id="controls-panel" class="controls card"{{if .SwapOOB}} hx-swap-oob="outerHTML"{{end}}>
  <div class="controls-section">
    <div class="section-label">Actions</div>
    <div class="action-row">
      <button type="button" id="open-add" class="primary"
        hx-get="{{.DashboardURL}}"
        hx-swap="none"
        hx-include="#view-state">Add</button>
      {{if .HasSelected}}
      <button type="button" id="toggle-selected" class="secondary"
        hx-post="/ui/torrents/{{urlquery .SelectedHash}}/{{if .SelectedRunning}}stop{{else}}start{{end}}"
        hx-swap="none"
        hx-include="#view-state">{{if .SelectedRunning}}Stop{{else}}Start{{end}}</button>
      <button type="button" id="recheck-selected" class="secondary"
        hx-post="/ui/torrents/{{urlquery .SelectedHash}}/recheck"
        hx-swap="none"
        hx-include="#view-state">Recheck</button>
      <button type="button" id="open-remove" class="danger"
        hx-get="{{.DashboardURL}}"
        hx-swap="none"
        hx-include="#view-state">Remove</button>
      {{else}}
      <button type="button" id="toggle-selected" class="secondary" disabled>Start</button>
      <button type="button" id="recheck-selected" class="secondary" disabled>Recheck</button>
      <button type="button" id="open-remove" class="danger" disabled>Remove</button>
      {{end}}
      <button type="button" id="open-columns" class="secondary"
        hx-get="{{.DashboardURL}}"
        hx-swap="none"
        hx-include="#view-state">Columns</button>
      <button type="button" id="refresh" class="secondary"
        hx-get="{{.DashboardURL}}"
        hx-target="#dashboard"
        hx-swap="outerHTML">Refresh</button>
    </div>
    {{template "remove-dialog" .}}
    {{template "columns-dialog" .}}
  </div>
  <div class="controls-divider"></div>
  <div class="controls-section">
    <div class="section-label">Filter View</div>
    <div class="filter-row" id="filters">
      <button type="button" data-filter="all" class="{{if eq .Params.Filter "all"}}active{{end}}"
        hx-get="{{index .FilterURLs "all"}}"
        hx-target="#dashboard"
        hx-swap="outerHTML">All</button>
      <button type="button" data-filter="downloading" class="{{if eq .Params.Filter "downloading"}}active{{end}}"
        hx-get="{{index .FilterURLs "downloading"}}"
        hx-target="#dashboard"
        hx-swap="outerHTML">Downloading</button>
      <button type="button" data-filter="seeding" class="{{if eq .Params.Filter "seeding"}}active{{end}}"
        hx-get="{{index .FilterURLs "seeding"}}"
        hx-target="#dashboard"
        hx-swap="outerHTML">Seeding</button>
      <button type="button" data-filter="complete" class="{{if eq .Params.Filter "complete"}}active{{end}}"
        hx-get="{{index .FilterURLs "complete"}}"
        hx-target="#dashboard"
        hx-swap="outerHTML">Complete</button>
      <button type="button" data-filter="stopped" class="{{if eq .Params.Filter "stopped"}}active{{end}}"
        hx-get="{{index .FilterURLs "stopped"}}"
        hx-target="#dashboard"
        hx-swap="outerHTML">Stopped</button>
    </div>
  </div>
  <div class="controls-divider"></div>
  <div class="controls-section">
    <div class="section-label">Search</div>
    <form id="search-form" class="search-form" method="get"
      hx-get="/ui/dashboard"
      hx-target="#dashboard"
      hx-swap="outerHTML">
      <label class="search-field" for="search-query">
        <span>Torrent</span>
        <input type="search" id="search-query" name="q" value="{{.Params.Query}}" placeholder="Name">
      </label>
      <input type="hidden" name="filter" value="{{.Params.Filter}}">
      <input type="hidden" name="sort" value="{{.Params.Sort}}">
      <input type="hidden" name="dir" value="{{.Params.Dir}}">
      <input type="hidden" name="selected" value="{{.Params.Selected}}">
      <input type="hidden" name="cols" value="{{.Params.Cols}}">
      <button type="submit" class="secondary">Search</button>
    </form>
  </div>
  <div class="controls-divider"></div>
  <div class="controls-section">
    <div class="section-label">Speed Limits</div>
    <form id="speed-limit-form" class="speed-limit-form" method="post"
      hx-post="/ui/speed-limits"
      hx-swap="none"
      hx-include="#view-state">
      <label class="speed-limit-field" for="download-limit-kib">
        <span>Down KiB/s</span>
        <input type="number" id="download-limit-kib" name="downloadLimitKiB" min="0" step="1" value="{{.DownloadLimitKiB}}">
      </label>
      <label class="speed-limit-field" for="upload-limit-kib">
        <span>Up KiB/s</span>
        <input type="number" id="upload-limit-kib" name="uploadLimitKiB" min="0" step="1" value="{{.UploadLimitKiB}}">
      </label>
      <button type="submit" class="secondary">Apply</button>
    </form>
  </div>
</section>
{{end}}

{{define "columns-dialog"}}
<dialog id="columns-dialog" class="add-dialog columns-dialog"{{if .OpenColumnsDialog}} open{{end}}>
  <form id="columns-form" class="add-form columns-form" method="get"
    hx-get="/ui/dashboard"
    hx-target="#dashboard"
    hx-swap="outerHTML"
    hx-include="#view-state">
    <h2>Visible Columns</h2>
    <input type="hidden" name="applyCols" value="1">
    <div class="columns-grid">
      {{range .Columns}}
      <label class="column-visibility-option"><input type="checkbox" name="visibleCol" value="{{.Key}}"{{if index $.VisibleColumns .Key}} checked{{end}}><span>{{.Label}}</span></label>
      {{end}}
    </div>
    <div class="dialog-actions">
      <button type="button" id="cancel-columns" class="secondary"
        hx-get="{{.DashboardURL}}"
        hx-target="#cancel-columns"
        hx-swap="none">Cancel</button>
      <button type="submit" id="apply-columns" class="primary">Apply</button>
    </div>
  </form>
</dialog>
{{end}}

{{define "remove-dialog"}}
<dialog id="remove-dialog" class="add-dialog remove-dialog"{{if .OpenRemoveDialog}} open{{end}}>
  <form id="remove-form" class="add-form remove-form" method="post"
    {{if .HasSelected}}hx-post="/ui/torrents/{{urlquery .SelectedHash}}/remove" hx-swap="none" hx-include="#view-state,#remove-delete-data"{{end}}>
    <h2>Remove Torrent</h2>
    <div class="remove-summary">
      <p><strong>Name:</strong> {{if .HasSelected}}{{.SelectedName}}{{else}}No torrent selected{{end}}</p>
      {{if .HasSelected}}
      <p><strong>Hash:</strong> <code>{{.SelectedHash}}</code></p>
      {{end}}
    </div>
    <label class="remove-delete-toggle" for="remove-delete-data">
      <input type="checkbox" id="remove-delete-data" name="deleteData" value="true"{{if not .HasSelected}} disabled{{end}}>
      <span>Delete data from disk</span>
    </label>
    <div class="dialog-actions">
      <button type="button" id="cancel-remove" class="secondary"
        hx-get="{{.DashboardURL}}"
        hx-swap="none"
        hx-include="#view-state">Cancel</button>
      <button type="submit" id="confirm-remove" class="danger"{{if not .HasSelected}} disabled{{end}}>Remove</button>
    </div>
  </form>
</dialog>
{{end}}

{{define "add-dialog"}}
<dialog id="add-dialog" class="add-dialog"{{if .OpenAddDialog}} open{{end}}{{if .SwapOOB}} hx-swap-oob="outerHTML"{{end}}>
  <form id="add-form" class="add-form" method="post"
    hx-post="/ui/torrents"
    hx-swap="none"
    hx-encoding="multipart/form-data"
    hx-include="#view-state">
    <h2>Add Torrent</h2>
    {{if .AddFormError}}
    <p class="add-form-error" role="alert">{{.AddFormError}}</p>
    {{end}}
    <label class="field" for="magnet">
      <span>Magnet</span>
      <input type="url" id="magnet" name="magnet" placeholder="magnet:?xt=urn:btih:..." value="{{.AddFormMagnet}}">
    </label>
    <label class="field" for="torrent">
      <span>.torrent</span>
      <input type="file" id="torrent" name="torrent" accept=".torrent,application/x-bittorrent">
    </label>
    <div class="dialog-actions">
      <button type="button" id="cancel-add" class="secondary"
        hx-get="{{.DashboardURL}}"
        hx-swap="none">Cancel</button>
      <button type="submit" id="add-btn" class="primary">Add</button>
    </div>
  </form>
</dialog>
{{end}}

{{define "status"}}
{{$statusKind := .StatusKind}}
{{if eq $statusKind ""}}{{$statusKind = "info"}}{{end}}
<div id="form-message" class="message status-message message-{{$statusKind}}{{if eq .StatusMessage ""}} is-hidden{{end}}" sse-swap="status" hx-swap="outerHTML"{{if .SwapOOB}} hx-swap-oob="outerHTML"{{end}} role="status" aria-live="polite">
  <span id="form-message-text">{{.StatusMessage}}</span>
  <button type="button" id="form-message-close" class="message-close" aria-label="Dismiss message" hx-get="/_empty" hx-target="#form-message" hx-swap="outerHTML">x</button>
  {{if and (ne .StatusMessage "") (ne $statusKind "error")}}
  <div class="message-autodismiss" hx-get="/_empty" hx-trigger="load delay:4s" hx-target="#form-message" hx-swap="outerHTML"></div>
  {{end}}
</div>
{{end}}

{{define "stats"}}
<div id="global-stats" class="global-stats" sse-swap="stats" hx-swap="outerHTML"{{if .SwapOOB}} hx-swap-oob="outerHTML"{{end}}>{{.VisibleCount}} torrents | ↓ {{.TotalDownRate}} | ↑ {{.TotalUpRate}}</div>
{{end}}

{{define "file-list"}}
<section id="file-list" class="table-panel card"{{if .SwapOOB}} hx-swap-oob="outerHTML"{{end}}>
  <div class="table-wrap">
    <table id="torrent-table">
      <colgroup>
        {{range .Columns}}
        {{if index $.VisibleColumns .Key}}<col data-col="{{.Key}}">{{end}}
        {{end}}
      </colgroup>
      <thead>
        <tr>
          {{range .Columns}}
          {{if index $.VisibleColumns .Key}}
          <th data-col="{{.Key}}" data-min-width="{{.MinWidth}}">
            {{if .Sortable}}
            <button type="button" class="sort-btn" data-sort="{{.Key}}" hx-get="{{index $.SortURLs .Key}}" hx-target="#dashboard" hx-swap="outerHTML">{{.Label}}{{if eq $.Params.Sort .Key}} {{if eq $.Params.Dir "asc"}}▲{{else}}▼{{end}}{{end}}</button>
            {{else}}
            <span class="th-label">{{.Label}}</span>
            {{end}}
          </th>
          {{end}}
          {{end}}
        </tr>
      </thead>
      {{template "table" .}}
    </table>
  </div>
</section>
{{end}}

{{define "table"}}
  <tbody id="torrents-body" sse-swap="table" hx-swap="outerHTML">
  {{if .Torrents}}
    {{range .Torrents}}
      {{$row := .}}
      <tr data-hash="{{.Hash}}" class="{{if .Active}}active{{end}}"
        hx-get="{{.SelectURL}}"
        hx-target="#dashboard"
        hx-swap="outerHTML">
        {{range $col := $.Columns}}
        {{if index $.VisibleColumns $col.Key}}
        {{if eq $col.Key "name"}}<td class="name">{{$row.Name}}</td>{{end}}
        {{if eq $col.Key "hash"}}<td class="hash">{{$row.Hash}}</td>{{end}}
        {{if eq $col.Key "state"}}<td><span class="state {{$row.StateClass}}">{{$row.State}}</span></td>{{end}}
        {{if eq $col.Key "addedAt"}}<td class="added">{{$row.AddedAt}}</td>{{end}}
        {{if eq $col.Key "progress"}}<td>
          <div class="progress-wrap">
            <progress class="progress" max="1" value="{{$row.ProgressValue}}"></progress>
            <span class="percent">{{$row.ProgressPct}}%</span>
          </div>
        </td>{{end}}
        {{if eq $col.Key "etaSeconds"}}<td class="eta">{{$row.ETA}}</td>{{end}}
        {{if eq $col.Key "ratio"}}<td class="ratio">{{$row.Ratio}}</td>{{end}}
        {{if eq $col.Key "peers"}}<td class="peers">{{$row.Peers}}</td>{{end}}
        {{if eq $col.Key "seeds"}}<td class="seeds">{{$row.Seeds}}</td>{{end}}
        {{if eq $col.Key "downRate"}}<td class="down">{{$row.DownRate}}</td>{{end}}
        {{if eq $col.Key "upRate"}}<td class="up">{{$row.UpRate}}</td>{{end}}
        {{if eq $col.Key "sizeBytes"}}<td class="size">{{$row.Size}}</td>{{end}}
        {{end}}
        {{end}}
      </tr>
    {{end}}
  {{else}}
    <tr><td colspan="{{.VisibleColCount}}" class="placeholder">No torrents in this view</td></tr>
  {{end}}
</tbody>
{{end}}
